<Window
    x:Class="ContactosApp1.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24" ColumnSpacing="24" Background="#F3F6FB">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="12">
            <TextBlock Text="Agenda de contactos" FontSize="24" FontWeight="SemiBold"
                       Foreground="#1F3A5F"/>
            <TextBox x:Name="NombreBox" Header="Nombre" PlaceholderText="Ej. Ana López"/>
            <TextBox x:Name="CorreoBox" Header="Correo" PlaceholderText="ana@correo.com"/>
            <TextBox x:Name="EdadBox" Header="Edad" PlaceholderText="Ej. 25"/>
            <TextBlock x:Name="MensajeText" Foreground="Firebrick" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Guardar" Click="Guardar_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="Eliminar" Click="Eliminar_Click"/>
            </StackPanel>
        </StackPanel>

        <ListView x:Name="ListaContactos" Grid.Column="1" Background="White"
                  CornerRadius="8" Padding="8">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Padding="4,8">
                        <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Correo}" Opacity="0.7"/>
                        <TextBlock Text="{Binding Edad}" Opacity="0.7"/>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Window>
